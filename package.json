{
  "name": "import-database",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "build": {
    "appId": "com.example.importdatabase",
    "productName": "Import Database",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "start": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "cross-env ELECTRON_DEV=1 concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:hot": "cross-env ELECTRON_DEV=1 npm run dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "antd": "^5.18.4",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0-rc.12",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^23.1.3",
    "electron-builder": "^26.0.12",
    "vite": "^5.1.0"
  }
}
